{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?i).*(edit|write|patch).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/canon_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session_banner.py\""
          }
        ]
      }
    ]
  }
}
