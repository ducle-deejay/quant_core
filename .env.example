# =============================================================================
# quant_core environment template - copy to .env and fill in real values.
# .env is gitignored; never commit credentials.
# =============================================================================

# --- DNSE OpenAPI credentials (market data, daily ETL) -----------------------
# Used by: apps/data/daily/pipeline.py, apps/data/sources/dnse/pipeline.py
API_KEY=
API_SECRET=

# --- entrade demo account (paper execution, milestone 1) ---------------------
# Used by: apps/trading/paper.py (entrade demo execution client)
# ENTRADE_USERNAME = entrade login identifier (an email for this account) -
# NOT the numeric investor id; the two are different credentials.
# ENTRADE_INVESTOR_ID = numeric investor id printed by
# apps/trading/check_auth.py on success; optional - auto-resolved from the
# auth token when unset.
ENTRADE_USERNAME=
ENTRADE_PASSWORD=
ENTRADE_INVESTOR_ID=

# --- Telegram alerts: data ingest bot (daily ETL) ----------------------------
# Bot suggestion (create via @BotFather; username must end with "bot"):
# display "QuantCore Data ETL", username @quantcore_data_etl_bot
# Both must be set together; alerts skipped when unset.
# Used by: apps/data/daily/pipeline.py via market_data.notify.data_notifier_from_env
DATA_TELEGRAM_BOT_TOKEN=
DATA_TELEGRAM_CHAT_ID=

# --- Telegram alerts: live trading bot (paper/live) ---------------------------
# Bot suggestion (create via @BotFather): display "QuantCore Trading Monitor
# (Paper)", username @quantcore_trading_monitor_paper_bot (env-tagged: paper;
# a separate live bot comes with Phase 5).
# Both must be set together; alerts skipped when unset.
# Used by: apps/trading/paper.py via market_data.notify.trading_notifier_from_env
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_CHAT_ID=

# --- Bot naming convention (approved 2026-08-30) ------------------------------
# username: quantcore_<domain>_<role>[_<env>]_bot  (5-32 chars, latin+digits+
# underscore only, must end "bot"; env tag required for anything trade-related)
# display : QuantCore <Domain> <Role> [· <Env>]
# prefix  : QC-<DOMAIN> in every alert text (QC-DATA, QC-TRADING, ...)
# domains : data | trading | risk | research | ops
# roles   : etl | monitor | alerts | watch | notify
# examples: quantcore_risk_watch_bot / "QuantCore Risk Watch",
#           quantcore_trading_monitor_live_bot / "QuantCore Trading Monitor (Live)"

# --- Optional ----------------------------------------------------------------
# Log level for the trading node (INFO default)
LOG_LEVEL=INFO
