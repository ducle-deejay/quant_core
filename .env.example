# =============================================================================
# quant_core environment template - copy to .env and fill in real values.
# .env is gitignored; never commit credentials.
# =============================================================================

# --- DNSE OpenAPI credentials (market data, daily ETL) -----------------------
# Used by: apps/data/daily/pipeline.py, apps/data/sources/dnse/pipeline.py
API_KEY=
API_SECRET=

# --- entrade demo account (paper execution, milestone 1) ---------------------
# Used by: apps/trading/paper.py (entrade demo execution client)
ENTRADE_USERNAME=
ENTRADE_PASSWORD=
ENTRADE_INVESTOR_ID=

# --- Telegram alerts: data ingest bot (daily ETL) ----------------------------
# Bot suggestion: display "QuantCore Data ETL", username @quantcore_data_etl_bot
# (create via @BotFather; username must end with "bot").
# Both must be set together; alerts skipped when unset.
# Used by: apps/data/daily/pipeline.py via market_data.notify.data_notifier_from_env
DATA_TELEGRAM_BOT_TOKEN=
DATA_TELEGRAM_CHAT_ID=

# --- Telegram alerts: live trading bot (paper/live) ---------------------------
# Bot suggestion: display "QuantCore Trading Monitor", username
# @quantcore_trading_monitor_bot (create via @BotFather).
# Both must be set together; alerts skipped when unset.
# Used by: apps/trading/paper.py via market_data.notify.trading_notifier_from_env
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_CHAT_ID=

# --- Optional ----------------------------------------------------------------
# Log level for the trading node (INFO default)
LOG_LEVEL=INFO
